{
 "doctype":"DocType",
 "name":"EdgePay Webhook Event",
 "module":"EdgePay",
 "autoname":"naming_series:",
 "naming_rule":"By \"Naming Series\" field",
 "track_changes":1,
 "engine":"InnoDB",
 "field_order":["naming_series","merchant","provider_account","provider","event_type","processing_status","event_reference","idempotency_key","received_on","signature_valid","links_section","linked_payment_request","linked_payment_transaction","payload_section","payload_json","error_section","error_message"],
 "fields":[
  {"fieldname":"naming_series","fieldtype":"Select","label":"Naming Series","options":"EP-WHE-.YYYY.-","default":"EP-WHE-.YYYY.-","reqd":1},
  {"fieldname":"merchant","fieldtype":"Link","label":"Merchant","options":"EdgePay Merchant","search_index":1},
  {"fieldname":"provider_account","fieldtype":"Link","label":"Provider Account","options":"EdgePay Provider Account","search_index":1},
  {"fieldname":"provider","fieldtype":"Link","label":"Provider","options":"EdgePay Provider","reqd":1},
  {"fieldname":"event_type","fieldtype":"Data","label":"Event Type"},
  {"fieldname":"processing_status","fieldtype":"Select","label":"Processing Status","options":"Pending\nProcessed\nFailed\nIgnored","default":"Pending","reqd":1},
  {"fieldname":"event_reference","fieldtype":"Data","label":"Event Reference","search_index":1},
  {"fieldname":"idempotency_key","fieldtype":"Data","label":"Idempotency Key","search_index":1},
  {"fieldname":"received_on","fieldtype":"Datetime","label":"Received On"},
  {"fieldname":"signature_valid","fieldtype":"Check","label":"Signature Valid","default":"0"},
  {"fieldname":"links_section","fieldtype":"Section Break","label":"Linked Documents"},
  {"fieldname":"linked_payment_request","fieldtype":"Link","label":"Linked Payment Request","options":"EdgePay Payment Request"},
  {"fieldname":"linked_payment_transaction","fieldtype":"Link","label":"Linked Payment Transaction","options":"EdgePay Payment Transaction"},
  {"fieldname":"payload_section","fieldtype":"Section Break","label":"Payload JSON","collapsible":1},
  {"fieldname":"payload_json","fieldtype":"Code","label":"Payload JSON","options":"JSON"},
  {"fieldname":"error_section","fieldtype":"Section Break","label":"Error Logging","depends_on":"eval:doc.processing_status=='Failed'"},
  {"fieldname":"error_message","fieldtype":"Text","label":"Error Message"}
 ],
 "permissions":[
  {"role":"EdgePay Admin","read":1,"write":1,"create":1,"delete":1,"report":1,"export":1},
  {"role":"EdgePay Manager","read":1,"write":1,"report":1},
  {"role":"EdgePay User","read":1,"report":1},
  {"role":"EdgePay Auditor","read":1,"report":1}
 ]
}
